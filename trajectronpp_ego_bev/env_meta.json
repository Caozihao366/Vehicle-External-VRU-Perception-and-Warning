{
  "coordinate_frame": "ego_bev",
  "axes": {
    "x": "forward (meters)",
    "y": "left (meters)",
    "heading": "radians, 0 = +x (forward), positive CCW"
  },
  "dt": 0.5,
  "frequency_hz": 2.0,
  "prediction_horizon_steps": 3,
  "prediction_horizon_seconds": 1.5,
  "trained_prediction_horizon_steps": 6,
  "trained_prediction_horizon_seconds": 3.0,
  "output_timestamps_sec": [0.5, 1.0, 1.5],

  "maximum_history_length": 8,
  "minimum_history_length": 1,
  "use_map_encoding": false,
  "checkpoint_epoch": 200,
  "node_types": ["VEHICLE", "PEDESTRIAN"],
  "attention_radius_m": {
    "PEDESTRIAN->PEDESTRIAN": 10.0,
    "PEDESTRIAN->VEHICLE": 20.0,
    "VEHICLE->PEDESTRIAN": 20.0,
    "VEHICLE->VEHICLE": 30.0
  },
  "vehicle_state_order": [
    ["position", "x"], ["position", "y"],
    ["velocity", "x"], ["velocity", "y"],
    ["acceleration", "x"], ["acceleration", "y"],
    ["heading", "°"], ["heading", "d°"]
  ],
  "pedestrian_state_order": [
    ["position", "x"], ["position", "y"],
    ["velocity", "x"], ["velocity", "y"],
    ["acceleration", "x"], ["acceleration", "y"]
  ],
  "notes": [
    "Train/eval used nuScenes mini ego-BEV pkl (no HD map).",
    "Upstream detections must already be in the same ego BEV frame at each history timestep.",
    "Ego itself is usually at (0,0) with heading 0 in the current frame; if you feed multi-frame history in a fixed current-ego frame, past ego motion should also be transformed into that same current-ego frame.",
    "Output trajectories are absolute positions in the same ego BEV frame (meters)."
  ]
}
